{
  "name": "streamplay4k-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "StreamPlay4K — static marketing site built with Eleventy.",
  "scripts": {
    "dev": "ELEVENTY_ENV=development eleventy --serve --quiet",
    "build": "ELEVENTY_ENV=production eleventy",
    "build:dev": "ELEVENTY_ENV=development eleventy",
    "clean": "rm -rf dist",
    "serve:dist": "npx --yes http-server dist -p 8081 -c-1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "lightningcss": "^1.33.0",
    "markdown-it-anchor": "^9.2.0"
  }
}
