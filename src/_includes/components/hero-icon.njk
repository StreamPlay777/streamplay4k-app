{#
  Four inline hero-stat icons. Local SVG, no icon library.
  Every icon is decorative — the card's value and label carry the meaning.

  {% from "components/hero-icon.njk" import heroIcon %}{{ heroIcon("broadcast") }}
#}
{% macro heroIcon(name) %}
<svg class="sp-stat__icon" width="18" height="18" viewBox="0 0 20 20" fill="none"
     aria-hidden="true" focusable="false" stroke="currentColor" stroke-width="1.5"
     stroke-linecap="round" stroke-linejoin="round">
  {%- if name == "broadcast" -%}
    <circle cx="10" cy="10" r="2"/>
    <path d="M6.2 13.8a5.4 5.4 0 0 1 0-7.6M13.8 6.2a5.4 5.4 0 0 1 0 7.6"/>
    <path d="M3.6 16.4a9 9 0 0 1 0-12.8M16.4 3.6a9 9 0 0 1 0 12.8"/>
  {%- elif name == "film" -%}
    <rect x="2.5" y="4" width="15" height="12" rx="2"/>
    <path d="M7 4v12M13 4v12M2.5 10h15"/>
  {%- elif name == "support" -%}
    <path d="M4 12v-2a6 6 0 1 1 12 0v2"/>
    <path d="M4 11.5h1.4a1 1 0 0 1 1 1v2.2a1 1 0 0 1-1 1H4.6a1.6 1.6 0 0 1-1.6-1.6v-1a1.6 1.6 0 0 1 1-1.6ZM16 11.5h-1.4a1 1 0 0 0-1 1v2.2a1 1 0 0 0 1 1h1a1.6 1.6 0 0 0 1.6-1.6v-1a1.6 1.6 0 0 0-1.2-1.6Z"/>
  {%- elif name == "quality" -%}
    <path d="M10 2.6 11.9 7l4.5.5-3.4 3 1 4.4L10 12.7 5.9 15l1-4.4-3.4-3L8 7Z"/>
  {%- endif -%}
</svg>
{% endmacro %}
