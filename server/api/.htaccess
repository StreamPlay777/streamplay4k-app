# Defence in depth for the /api/ directory.
#
# The site's root .htaccess already blocks these paths, but that file is
# regenerated by every deploy and this one sits next to the code it protects.
# If the root rules are ever lost, the Mailgun key stays unreachable.

<FilesMatch "^config.*\.php$">
  Require all denied
</FilesMatch>

# order.php is the only entry point; everything under lib/ and templates/ is
# an include and must never be requested directly.
RedirectMatch 403 ^/api/(lib|templates)/
