# StreamPlay4K — Apache configuration.
#
# ORDER MATTERS. The previous version rewrote every non-file request to
# index.html, which would now serve the HOMEPAGE for /pricing/, /terms/ and
# every other pre-rendered page — silently undoing the whole static build. The
# `!-d` condition on the fallback is what prevents that.

Options -MultiViews
RewriteEngine On

# ── One hostname ──────────────────────────────────────────────────────────────
# www and the bare domain both resolve — www by CNAME to the Hostinger CDN, the
# bare domain aliased onto the same edges — and both served the identical site.
# Two hostnames for one site is two copies of every page for a search engine to
# crawl and choose between. The canonical tag was the only thing preventing that
# from becoming an index problem; this makes it a non-question.
#
# FIRST, above every other rule, so no legacy or slash redirect below can fire
# on the www host and produce a two-hop chain.
#
# The target is https:// regardless of how the request arrived, so a www visit
# over http is fixed in one hop. There is deliberately NO separate http -> https
# rule for the bare domain: behind a CDN that terminates TLS and talks plain
# HTTP to the origin, such a rule redirects every request forever. Force HTTPS
# is Hostinger's job, in hPanel, where it knows which side of the CDN it is on.
RewriteCond %{HTTP_HOST} ^www\.streamplay4k\.com$ [NC]
RewriteRule ^ https://streamplay4k.com%{REQUEST_URI} [R=301,L]

# ── Old WordPress URLs ────────────────────────────────────────────────────────
# Google still holds addresses from the previous site. Each gets the one honest
# answer for what it was:
#
#   moved  — a 301 to the page that now does the same job. Only where the job
#            genuinely is the same: every old checkout and subscribe URL sold a
#            plan, and /pricing/ is where plans are sold now.
#   gone   — a 410 for WordPress's own machinery. These never had page content,
#            a redirect would tell probes that WordPress once lived here, and
#            410 drops them from the index faster than 404.
#
# Nothing else from the old site is redirected. A URL that matches none of
# these is a real 404 (see "Not found" below) — never a bounce to the homepage,
# which search engines read as a soft 404 and hold against the whole site.
# Absolute https targets, so the hop count is one however the CDN speaks to
# the origin: a relative target would be built from the origin's own scheme,
# and behind an edge that terminates TLS that can mean http:// — one more
# redirect before the customer arrives.
RewriteRule ^package/?$                       https://streamplay4k.com/pricing/  [R=301,L]
RewriteRule ^checkout-pack-[a-z0-9-]+/?$      https://streamplay4k.com/pricing/  [R=301,L]
RewriteRule ^subscribe-us-[a-z0-9-]+/?$       https://streamplay4k.com/pricing/  [R=301,L]
RewriteRule ^premium-4-devices/?$             https://streamplay4k.com/pricing/  [R=301,L]
RewriteRule ^tv-guide/?$                      https://streamplay4k.com/channels/ [R=301,L]
RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json)(/|$) - [G,L]
RewriteRule ^(wp-[a-z-]+|xmlrpc)\.php$        -          [G,L]

# ── Permanent redirect for the renamed setup route ────────────────────────────
RewriteRule ^setup/?$ /setup-guide/ [R=301,L]

# ── Canonical trailing slash ──────────────────────────────────────────────────
# /pricing -> /pricing/ where a pre-rendered directory exists. mod_dir would do
# this itself, but stating it keeps the canonical form explicit and stops the
# SPA fallback below from claiming the slashless form first.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# ── API ───────────────────────────────────────────────────────────────────────
# /api/order has no extension and no file on disk under that exact name. Without
# these rules it would be a 404, and fetch() would report the order as failed.
RewriteRule ^api/order/?$ /api/order.php [L]
RewriteRule ^api/lead/?$ /api/lead.php [L]
RewriteRule ^api/stripe-webhook/?$ /api/stripe-webhook.php [L]

# Nothing else under /api/ is meant to be reachable. lib/ and templates/ are
# includes, config.php holds the Mailgun and Stripe keys, and cron/ sends mail
# — reachable over HTTP it would be a button anyone could press to blast your
# customer list. Deny them outright rather than relying on PHP to refuse.
# (followups.php also checks PHP_SAPI itself; this is the belt to that brace.)
RewriteRule ^api/(lib|templates|cron)/ - [F,L]
RewriteRule ^api/config(\.example)?\.php$ - [F,L]

# ── Not found ─────────────────────────────────────────────────────────────────
# There is no SPA fallback, on purpose. Every route the app has is pre-rendered
# to a real file at build time — pages, every blog post, every campaign landing
# — so a URL with nothing on disk is not a page that has yet to hydrate; it is
# a URL that does not exist. The previous fallback rewrote every such request
# to index.html: a 200, the homepage's content, the homepage's canonical. To a
# crawler that was sixty copies of the homepage, which is precisely what Search
# Console reported.
#
# 404.html is pre-rendered like every other page, inside the normal shell, and
# Apache serves it with the status a missing page deserves.
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# ── Dashboard ─────────────────────────────────────────────────────────────────
# /admin/ is a real directory with index.php, so the fallback above already
# leaves it alone. What it must never do is get cached or indexed.

# index.php is the only entry point. lib/ holds the session, CSRF and action
# handling and pages/ holds the screens; both expect to be included after the
# login check has already passed, so neither may be requested on its own.
# (Each file refuses to run without SP_ADMIN as well — this is the second lock.)
RewriteRule ^admin/(lib|pages)/ - [F,L]
<IfModule mod_headers.c>
  <FilesMatch "^index\.php$">
    Header set Cache-Control "no-store, private"
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# ── Caching ───────────────────────────────────────────────────────────────────
# Hashed assets are immutable; HTML must revalidate so a deploy is picked up.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
