# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# TMDB — powers the recent best-rated films and series on the home page.
# Get a free key at themoviedb.org > Settings > API.
# Without it the site falls back to the bundled title list; nothing breaks.
VITE_TMDB_KEY=

# Order endpoint. Leave blank in development — the order form then reports
# clearly that nothing was sent, rather than faking a successful submission.
VITE_ORDER_ENDPOINT=

# Optional: base URL for your own poster artwork, if you host it yourself.
VITE_POSTER_BASE=
